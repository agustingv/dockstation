<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>DockStation</name>
  <summary>Manage and create Docker Compose projects</summary>
  <description>
    <p>
      DockStation keeps all your Docker Compose projects in one place.
      Start, stop and restart services, follow their logs, edit the
      configuration and create new projects from ready-made templates.
    </p>
  </description>
  <developer id="io.github.agustingv">
    <name>Agustin Garcia</name>
  </developer>
  <url type="homepage">https://agustingv.github.io/dockstation/</url>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.1.6" date="2026-10-31">
      <description>
        <p>Internal improvements, with tests for resetting databases and removing services.</p>
      </description>
    </release>
    <release version="0.1.5" date="2026-10-31">
      <description>
        <p>Internal improvements, with faster checks of a project's containers.</p>
      </description>
    </release>
    <release version="0.1.4" date="2026-10-31">
      <description>
        <p>Fixes:</p>
        <ul>
          <li>The message shown when Docker cannot be reached is readable again</li>
          <li>Logs no longer show stray terminal codes before each line</li>
          <li>Quotes display correctly in configuration errors</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-10-31">
      <description>
        <p>A project whose folder has already been deleted can now be deleted from DockStation.</p>
      </description>
    </release>
    <release version="0.1.2" date="2026-10-31">
      <description>
        <p>The Fedora package now also installs the graphics library DockStation needs to start on desktops other than GNOME.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-30">
      <description>
        <p>Packages for Debian, Ubuntu, Fedora and openSUSE, with a download page and updates through APT and DNF.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-02">
      <description>
        <p>First release.</p>
        <ul>
          <li>Manage Docker Compose projects: start, stop and restart services and follow their logs</li>
          <li>Docker resource manager for containers, images, volumes and disk usage</li>
          <li>Configuration editor that validates changes before saving</li>
          <li>Add ready-made services to a project from templates</li>
          <li>Links to the URLs Traefik exposes for your services</li>
          <li>Keeps running in the background, with a tray icon</li>
          <li>Spanish translation</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
